          "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/spend_record.py"],
          "timeout": 30
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python",
          "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/spend_record.py"],
          "timeout": 30
        }
      ]
    }
  ]
}
