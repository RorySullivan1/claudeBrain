{
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "python",
          "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/spend_record.py"],
          "timeout": 30
        }
      ]
    }
  ],
  "SubagentStop": [
    {
      "hooks": [
        {
          "type": "command",
